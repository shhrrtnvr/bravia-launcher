<?xml version="1.0" encoding="utf-8"?>
<!-- Layers, back to front: seasonal scene, falling petals/snow, glass keys. 960x540 dp screen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ImageView
        android:id="@+id/scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <io.github.shhrrtnvr.bravialauncher.ParticlesView
        android:id="@+id/particles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/edge"
        android:paddingTop="26dp"
        android:paddingEnd="@dimen/edge">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:clipChildren="false"
            android:orientation="horizontal">

            <io.github.shhrrtnvr.bravialauncher.GlassKey
                android:id="@+id/clock_bar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:focusable="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.02"
                        android:textSize="44sp" />

                    <TextClock
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:format12Hour="EEEE, d MMMM"
                        android:format24Hour="EEEE, d MMMM"
                        android:textSize="14sp" />

                    <!-- Shown only when an app that belongs on internal storage was moved to USB. -->
                    <TextView
                        android:id="@+id/storage_note"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </io.github.shhrrtnvr.bravialauncher.GlassKey>

            <io.github.shhrrtnvr.bravialauncher.GlassKey
                android:id="@+id/vpn"
                android:layout_width="230dp"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:clickable="true"
                android:contentDescription="@string/vpn_title"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="16dp">

                    <!-- One line per VPN group with a choice, e.g. "UK apps  London" / "YouTube  US". -->
                    <TextView
                        android:id="@+id/vpn_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/vpn_state"
                        android:ellipsize="end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textSize="15sp" />
                </LinearLayout>
            </io.github.shhrrtnvr.bravialauncher.GlassKey>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/favourites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:clipChildren="false"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/apps_row"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="18dp"
            android:clipChildren="false"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- All apps page: search + sort bar, then the grid. -->
    <LinearLayout
        android:id="@+id/all_apps_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingTop="26dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/all_apps_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clipChildren="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/edge"
            android:paddingEnd="@dimen/edge" />

        <io.github.shhrrtnvr.bravialauncher.AllAppsGrid
            android:id="@+id/all_apps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="@dimen/grid_edge"
            android:paddingTop="10dp"
            android:paddingEnd="@dimen/grid_edge"
            android:paddingBottom="40dp"
            android:scrollbars="none" />
    </LinearLayout>
</FrameLayout>
